# Optional: search Thingiverse via its API before falling back to scraping.
THINGIVERSE_ACCESS_TOKEN=
# Optional: MyMiniFactory developer API key and CGTrader OAuth access token.
MYMINIFACTORY_API_KEY=
CGTRADER_ACCESS_TOKEN=
# Optional: Cults3D account username and key from https://cults3d.com/en/api/keys
CULTS3D_USERNAME=
CULTS3D_API_KEY=
# Optional: TraceParts credentials and a catalog/EasyLink approved for this use.
# https://developers.traceparts.com/docs/requesting-apikey
TRACEPARTS_API_KEY=
TRACEPARTS_TENANT_UID=
TRACEPARTS_CLASSIFICATION_CODE=
TRACEPARTS_EASYLINK_ID=
# Optional: restrict the permitted catalog to a single category.
TRACEPARTS_CATEGORY_CODE=
